# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Virtualenv
venv/
env/
.venv/

# Distribution / packaging
build/
dist/
*.egg-info/

# PyInstaller
#  Usually these files are written by a python script from a template
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
.coverage
.cache
nosetests.xml
coverage.xml
*,cover

# mypy
.mypy_cache/

# dotenv environment variables file
.env
.env.local

# Editor directories and files
.vscode/
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db

# ffmpeg binaries if accidentally placed
ffmpeg*
